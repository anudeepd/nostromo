{
  "name": "xwing-frontend",
  "version": "0.3.34",
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "node bundle-editor.mjs && node build-frontend.mjs",
    "build:app": "node build-frontend.mjs",
    "build:editor": "node bundle-editor.mjs",
    "lint": "cd .. && scripts/node_modules/.bin/eslint eslint.config.mjs xwing/frontend/src scripts/tests scripts/e2e scripts/*.mjs scripts/*.ts",
    "test": "vitest run tests --environment jsdom",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --project=chromium --update-snapshots",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/legacy-modes": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@eslint/js": "^10.0.1",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "@playwright/test": "^1.55.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
